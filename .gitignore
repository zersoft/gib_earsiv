data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Dizin yapısını korumak için .gitkeep dosyalarını hariç tutma
!data/.gitkeep
!config/.gitkeep
