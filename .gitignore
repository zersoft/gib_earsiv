# Bağımlılıklar
node_modules/

# Ortam Değişkenleri ve Gizli Anahtarlar
.env
.env.local
.env.*.local

# Günlük / Log Dosyaları
*.log
npm-debug.log*
yarn-debug.log*

# İşletim Sistemi Dosyaları
.DS_Store
Thumbs.db

